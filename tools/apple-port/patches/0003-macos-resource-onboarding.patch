+		int ready = Arena_PrepareArguments(&argc, &argv);
+		if (ready <= 0)
+			return ready < 0 ? 1 : 0;
+	}
+#endif
+
 #ifdef USE_AUTOUPDATER
 	Sys_LaunchAutoupdater(argc, argv);
 #endif
